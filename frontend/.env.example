# Copy to .env.production.local (or set in CI) before `npm run build`.
# Base URL of the backend API, without a trailing slash. Empty = same origin as the frontend.
VITE_API_URL=https://api.example.com
# SockJS endpoint. Optional, defaults to ${VITE_API_URL}/ws.
VITE_WS_URL=https://api.example.com/ws
# Google OAuth client id (must match GOOGLE_CLIENT_ID on the backend).
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
