# Settings of the production stack (KAN-104). The real file is /opt/syncchord/.env on the instance, mode 600, owned by
# root. Never commit it. Generate the secrets as shown in README.md.

# Public host name (Caddy's certificate, CORS origin, TURN URLs). Without https:// or a path.
APP_DOMAIN=myname.duckdns.org
# DuckDNS account token (duckdns.org, top of the page): syncchord-up.sh points APP_DOMAIN at the instance's current
# public IP on every boot. Leave empty for a domain that is not on DuckDNS and set its DNS record yourself.
DUCKDNS_TOKEN=

# Where the images come from: ghcr.io/<GitHub owner, lower case>. IMAGE_TAG defaults to latest.
IMAGE_REGISTRY=ghcr.io/your-github-name
IMAGE_TAG=latest

# PostgreSQL (container on the instance; data in the pgdata volume)
DB_NAME=music_app_db
DB_USERNAME=syncchord
DB_PASSWORD=

# Secrets of the backend; SecretsStartupCheck refuses empty ones and the values committed for local/test
JWT_SECRET=
ENCRYPTION_SECRET=
TURN_SECRET=

# Google sign-in: the same OAuth client id the frontend image was built with (VITE_GOOGLE_CLIENT_ID).
# Add https://<APP_DOMAIN> to the client's authorized JavaScript origins in the Google Cloud console.
GOOGLE_CLIENT_ID=

# Uploads bucket: `terraform output -raw uploads_bucket`. S3 credentials come from the instance role.
AWS_REGION=eu-central-1
MINIO_BUCKET_NAME=

# Optional overrides (defaults in docker-compose.prod.yml)
# On t4g.small (2 GB) the backend can have more memory:
# BACKEND_JAVA_OPTS=-Xmx768m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC -Xss512k
# BACKEND_MEM_LIMIT=1100m
# TURN_URLS=turn:myname.duckdns.org:3478?transport=udp,turn:myname.duckdns.org:3478?transport=tcp
# STUN_URLS=stun:myname.duckdns.org:3478
